# Security headers
# Strict Transport Security — enforce HTTPS for 1 year, include subdomains
https:serviceparadigm.com
https:*.serviceparadigm.com
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Frame protection + Content Security Policy
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Cache-Control headers for Cloudflare Pages deploy
# Immutable content — never changes once deployed

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short TTL since content updates
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600

/ /*.html
  Cache-Control: public, max-age=0, s-maxage=3600

# Favicon — rarely changes
/favicon.svg
  Cache-Control: public, max-age=86400
