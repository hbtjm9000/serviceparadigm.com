---
import '../styles/globals.css';
import SEOMeta from '../components/SEOMeta.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title = "Paradigm IT Services | Engineering the Next Paradigm",
  description = "Elite technology advisory and architecture firm focused on AI, secure infrastructure, and modern digital platforms.",
  ogImage = "/og-default.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="bg-surface">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <SEOMeta title={title} description={description} image={ogImage} url={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />

    <!-- Font preloads — critical for first paint -->
    <link rel="preload" href="/fonts/switzer/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/switzer/Switzer-VariableItalic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SLDE3K52MY"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SLDE3K52MY');
    </script>
    <!-- Feature flag bootstrap (GrowthBook SDK init) -->
    <script>
      import { getFlag } from '../lib/features';
      // Module import triggers GrowthBook SDK init; getFlag is available globally
      window.__featureFlags = { getFlag };
    </script>
    <!-- Analytics init — UTM capture + page type tracking -->
    <script>
      import { initAnalytics } from '../lib/analytics';
      if (typeof window !== 'undefined') {
        // Run after DOM is ready (gtag script may not be loaded yet)
        document.addEventListener('astro:page-load', () => initAnalytics());
        // Also fire on initial load (astro:page-load covers client nav)
        initAnalytics();
      }
    </script>
  </head>
  <body class="bg-surface text-on-surface antialiased">
    <!-- Skip to main content for keyboard users (WCAG 2.1 AA) -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      Skip to content
    </a>
    <slot />
    <ScrollToTop />
  </body>
</html>

<script>
  /* Mobile menu toggle — event delegation for View Transitions durability.
     Single listener on document survives all client-side navigations.
     Dynamically queries DOM on each click — no re-execution needed. */
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('#mobile-menu-btn');
    if (!btn) return;
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    menu.classList.toggle('hidden');
    menu.classList.toggle('opacity-0');
    menu.classList.toggle('opacity-100');
    btn.setAttribute('aria-expanded', String(!isExpanded));
  });
</script>
