---
// DigitalEmployeesSME.astro — SME entry path for homepage
---

<section class="bg-gradient-to-br from-secondary via-secondary to-primary/50 text-white py-28 lg:py-32 relative overflow-hidden">
  <div class="absolute -bottom-10 -right-20 text-[20rem] font-black text-white/5 font-headline pointer-events-none select-none" aria-hidden="true">
    Digital<br />Employees
  </div>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <span class="font-label text-xs tracking-[0.2em] text-secondary-fixed-dim uppercase">
        Launch Offer — 10 Spaces Available
      </span>
      <h2 class="font-headline text-4xl lg:text-5xl text-white mt-4 leading-[1.1] mb-6">
        Digital Employees for<br />
        <span class="italic text-secondary-fixed-dim">Jamaican Businesses.</span>
      </h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-10">
        AI workers that handle invoicing, scheduling, procurement, and customer resolution.
        Self-hosted on Jamaican infrastructure. Your data never leaves.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/digital-employees" 
          class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 bg-primary text-white hover:bg-primary/90 transition-colors"
        >
          Find Your Digital Employee
        </a>
        <a 
          href="/digital-employees#pricing" 
          class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 border border-white/30 text-white hover:bg-white hover:text-secondary transition-all"
        >
          See Pricing — From JMD 45,000/mo
        </a>
      </div>
    </div>

    <!-- Quick SME Types -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
      <div class="bg-white/10 backdrop-blur-sm p-6 text-center">
        <span class="font-label text-xs tracking-widest text-secondary-fixed-dim">Owner Operator</span>
        <p class="font-headline text-lg text-white mt-2">AI Chief of Staff</p>
      </div>
      <div class="bg-white/10 backdrop-blur-sm p-6 text-center">
        <span class="font-label text-xs tracking-widest text-secondary-fixed-dim">Growing SME</span>
        <p class="font-headline text-lg text-white mt-2">Department AI Team</p>
      </div>
      <div class="bg-white/10 backdrop-blur-sm p-6 text-center">
        <span class="font-label text-xs tracking-widest text-secondary-fixed-dim">Service Business</span>
        <p class="font-headline text-lg text-white mt-2">Operations Assistant</p>
      </div>
      <div class="bg-white/10 backdrop-blur-sm p-6 text-center">
        <span class="font-label text-xs tracking-widest text-secondary-fixed-dim">Professional Firm</span>
        <p class="font-headline text-lg text-white mt-2">Copilot Agent</p>
      </div>
    </div>
  </div>
</section>
