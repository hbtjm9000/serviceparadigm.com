---
import { Image } from 'astro:assets';
import logocolored from '../assets/images/logos/paradigm-logo-header-colored.png';
import logowhite from '../assets/images/logos/paradigm-logo-header-mono-white.png';
import logoteal from '../assets/images/logos/paradigm-logo-header-mono-teal.png';
import logogray from '../assets/images/logos/paradigm-logo-header-grayscale.png';
import ServicesMegaMenu from './ServicesMegaMenu.vue';
import ElementsMegaMenu from './ElementsMegaMenu.vue';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  logoVariant?: 'colored' | 'mono-white' | 'mono-teal' | 'grayscale';
}

const { logoVariant = 'colored' } = Astro.props;

const logoMap: Record<string, ImageMetadata> = {
  'colored': logocolored,
  'mono-white': logowhite,
  'mono-teal': logoteal,
  'grayscale': logogray,
};

const navItems: NavItem[] = [
  { label: 'Services', href: '/services' },
  { label: 'Elements', href: '/elements' },
  { label: 'Insights', href: '/insights' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="bg-primary/80 backdrop-blur-md text-white relative z-50" role="navigation">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <Image
          src={logoMap[logoVariant]}
          alt="Paradigm IT Services"
          class="h-10 w-auto object-contain"
          width="200"
          height="45"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <ServicesMegaMenu client:load />
        <ElementsMegaMenu client:load />
        {navItems.filter(i => i.label !== 'Services' && i.label !== 'Elements').map((item) => (
          <a
            href={item.href}
            class="font-headline italic text-lg text-slate-300 hover:text-white transition-colors tracking-tight"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center gap-6">
        <a
          href="https://calendar.app.google/teRByg9wRAUZSYww5"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-secondary text-secondary px-4 py-2 font-label uppercase tracking-widest text-xs hover:bg-secondary hover:text-white transition-all duration-200 rounded-none"
        >
          Book a Meeting
        </a>
        <a
          href="/contact"
          class="bg-primary hover:bg-secondary text-on-primary px-6 py-2 font-body uppercase tracking-widest text-xs transition-all duration-200 active:scale-95 rounded-none"
        >
          Get Started
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-white p-2"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 transition-opacity duration-200 opacity-0">
    <div class="flex flex-col gap-4">
      {navItems.filter(i => i.label !== 'Services').map((item) => (
        <a
          href={item.href}
          class="font-headline italic text-lg text-slate-300 hover:text-white transition-colors tracking-tight"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-2 pb-2">
        <span class="font-body text-xs text-slate-500 uppercase tracking-wider block mb-2">Services</span>
        <div class="flex flex-col gap-2 pl-2 border-l border-slate-700">
          <a href="/services/ai-strategy" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">AI Strategy</a>
          <a href="/services/solutions-architecture" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Solutions Architecture</a>
          <a href="/services/cybersecurity" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Cybersecurity</a>
        </div>
      </div>
      <div class="pt-1 pb-2">
        <span class="font-body text-xs text-slate-500 uppercase tracking-wider block mb-2">Elements</span>
        <div class="flex flex-col gap-2 pl-2 border-l border-slate-700">
          <a href="/elements/email" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Email</a>
          <a href="/elements/zero-trust" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Zero Trust</a>
          <a href="/elements/digital-presence" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Digital Presence</a>
          <a href="/elements/business-continuity" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Business Continuity</a>
          <a href="/elements/cloud" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Cloud</a>
          <a href="/elements/hermes-agent" class="font-headline italic text-base text-slate-300 hover:text-white transition-colors">Hermes Agent</a>
        </div>
      </div>
        <a
          href="https://calendar.app.google/teRByg9wRAUZSYww5"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-secondary text-secondary px-4 py-2 font-label uppercase tracking-widest text-xs hover:bg-secondary hover:text-white transition-all duration-200 inline-block w-fit rounded-none mt-4"
        >
          Book a Meeting
        </a>
        <a
          href="/contact"
          class="bg-primary hover:bg-secondary text-on-primary px-6 py-2 font-body uppercase tracking-widest text-xs transition-all duration-200 inline-block w-fit mt-2 rounded-none"
        >
          Get Started
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('opacity-0');
    mobileMenu?.classList.toggle('opacity-100');
    mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
  });
</script>
