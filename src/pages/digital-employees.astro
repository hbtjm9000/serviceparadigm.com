---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';

const smeTypes = [
  {
    type: 'Owner Operator',
    pain: 'Too much work, too few hours',
    agent: 'AI Chief of Staff',
    hook: 'Save 20+ hours/week on operations',
    price: 'JMD 45,000/mo',
  },
  {
    type: 'Growing SME',
    pain: 'Team inefficiency, manual processes',
    agent: 'Department AI Team',
    hook: 'Automate 3 workflows, scale without hiring',
    price: 'JMD 85,000/mo',
  },
  {
    type: 'Service Business',
    pain: 'Labour costs eating margins',
    agent: 'Operations AI Assistant',
    hook: 'Replace 20% of repetitive work without new hires',
    price: 'JMD 75,000/mo',
  },
  {
    type: 'Professional Firm',
    pain: 'Knowledge work drowning in admin',
    agent: 'Copilot AI Agent',
    hook: 'Cut research, drafting, and reporting time by 60%',
    price: 'JMD 99,000/mo',
  },
];

const agents = [
  {
    title: 'Invoicing & Collections Agent',
    description: 'Chase payments, send reminders, reconcile accounts — automatically. Stop chasing invoices. Let your Digital Employee handle the follow-ups, reminders, and payment reconciliation.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    title: 'Customer Resolution Agent',
    description: 'Handle inquiries, escalate complex cases, learn from every interaction. Your customers get instant responses. You keep the relationship.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
  },
  {
    title: 'Procurement Agent',
    description: 'Vendor selection, PO creation, delivery tracking — end to end. From request to delivery, your agent manages the supply chain steps.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`,
  },
  {
    title: 'Scheduling Agent',
    description: 'Appointment booking, calendar management, reminders — no human needed for the back-and-forth. Your customers book, the agent confirms, the calendar stays up to date.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  },
];

const steps = [
  { number: '01', title: 'Discovery', desc: 'We audit your business processes and identify the top 3 workflows ready for automation.' },
  { number: '02', title: 'Build', desc: 'We build your Digital Employee on open infrastructure — no lock-in, no per-seat fees.' },
  { number: '03', title: 'Train', desc: 'We train the agent on your data, your processes, and your way of doing business.' },
  { number: '04', title: 'Go Live', desc: 'Your Digital Employee is deployed. We monitor, tune, and support. You run the business.' },
];
---

<BaseLayout
  title="Digital Employees for Jamaican SMEs | Paradigm IT Services"
  description="AI workers that handle invoicing, scheduling, procurement, and customer resolution. Built in Jamaica. Self-hosted. First month free — limited to 10 businesses."
>
  <Header logoVariant="mono-white" />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-secondary via-secondary to-primary/50 text-white py-28 lg:py-36 relative overflow-hidden">
    <div class="absolute -bottom-10 -right-20 text-[20rem] font-black text-white/5 font-headline pointer-events-none select-none" aria-hidden="true">
      Digital<br />Employee
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-primary/30 text-primary-fixed px-4 py-2 font-label tracking-widest text-sm mb-6">
          Limited Launch — Only 10 Spaces
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline font-black mb-6 ink-bleed">
          Your Business Needs Digital Employees, Not Just Chatbots.
        </h1>
        <p class="text-xl text-white/90 mb-10 max-w-3xl mx-auto">
          AI workers that handle invoicing, scheduling, procurement, and customer resolution — 
          built for Jamaican SMEs. Self-hosted on local infrastructure. Your data never leaves Jamaica.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#find-your-agent" class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 bg-primary text-white hover:bg-primary/90 transition-colors">
            Find Your Agent
          </a>
          <a href="#pricing" class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 border border-white/30 text-white hover:bg-white hover:text-secondary transition-all">
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What is a Digital Employee -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <span class="font-label text-primary tracking-widest text-sm">From Chatbots to Digital Employees</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mt-4 mb-6">
          What's the Difference?
        </h2>
        <p class="text-lg text-on-surface-variant max-w-3xl mx-auto">
          A chatbot <em>answers questions</em>. A Digital Employee <em>does the work</em> — it chases payments, books appointments, resolves customer issues, and manages procurement end-to-end. It's not a conversation. It's a worker.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface-container p-8 text-center">
          <span class="font-label text-primary text-xs tracking-widest">Chatbot</span>
          <div class="text-4xl font-headline font-bold text-on-surface mt-2 mb-4">Answers</div>
          <p class="text-on-surface-variant">Passive. Responds when asked. No memory of yesterday. No ability to act.</p>
        </div>
        <div class="bg-secondary text-on-secondary p-8 text-center">
          <span class="font-label text-secondary-fixed text-xs tracking-widest">AI Agent</span>
          <div class="text-4xl font-headline font-bold mt-2 mb-4">Executes</div>
          <p class="text-white/80">Active. Follows instructions. Can use tools and make decisions within bounds.</p>
        </div>
        <div class="bg-primary text-on-primary p-8 text-center">
          <span class="font-label text-primary-fixed-dim text-xs tracking-widest">Digital Employee</span>
          <div class="text-4xl font-headline font-bold mt-2 mb-4">Owns</div>
          <p class="text-white/80">Autonomous. Owns a business process end-to-end. Learns. Adapts. Reports. Never takes leave.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Which SME Type Are You? -->
  <section id="find-your-agent" class="py-20 lg:py-28 bg-surface-container">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <span class="font-label text-primary tracking-widest text-sm">Find Your Digital Employee</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mt-4 mb-6">
          Which Business Are You?
        </h2>
        <p class="text-lg text-on-surface-variant max-w-3xl mx-auto">
          Different businesses need different Digital Employees. Find yours.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {smeTypes.map((sme) => (
          <div class="bg-surface p-8 border-t-4 border-primary hover:shadow-xl transition-shadow">
            <span class="font-label text-primary text-xs tracking-widest">{sme.type}</span>
            <h3 class="text-xl font-headline font-bold text-secondary mt-2 mb-2">{sme.agent}</h3>
            <p class="text-sm text-on-surface-variant mb-4">{sme.pain}</p>
            <div class="bg-primary/10 px-4 py-2 mb-4">
              <span class="font-label text-xs text-primary">{sme.hook}</span>
            </div>
            <p class="font-headline text-2xl font-bold text-secondary">{sme.price}</p>
            <p class="text-xs text-on-surface-variant">+ one-time onboarding</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Four Agents - Use Cases -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <span class="font-label text-primary tracking-widest text-sm">The Four Digital Employees</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mt-4 mb-6">
          Common Use Cases
        </h2>
        <p class="text-lg text-on-surface-variant max-w-3xl mx-auto">
          Start with one. Add more as you grow. Each Digital Employee handles a complete business process — from start to finish.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {agents.map((agent) => (
          <div class="bg-surface-container p-8 hover:shadow-lg transition-shadow border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/10 flex items-center justify-center mb-4">
              <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" set:html={agent.icon} />
            </div>
            <h3 class="text-xl font-headline font-bold text-secondary mb-3">{agent.title}</h3>
            <p class="text-on-surface-variant">{agent.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 lg:py-28 bg-surface-container">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <span class="font-label text-primary tracking-widest text-sm">How It Works</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mt-4 mb-6">
          From Zero to Digital Employee in 2 Weeks
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {steps.map((step) => (
          <div class="text-center">
            <div class="text-5xl font-headline font-black text-primary/20 mb-2">{step.number}</div>
            <h3 class="text-lg font-headline font-bold text-secondary mb-2">{step.title}</h3>
            <p class="text-sm text-on-surface-variant">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-20 lg:py-28 bg-secondary text-white relative overflow-hidden">
    <div class="absolute -top-20 -left-20 text-[18rem] font-black text-white/5 font-headline pointer-events-none select-none" aria-hidden="true">
      Limited
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <span class="inline-block bg-primary/30 text-primary-fixed px-4 py-2 font-label tracking-widest text-sm mb-6">
          Launch Offer — 10 Spaces Only
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold mb-4">
          Less Than a Junior Admin. Works 24/7.
        </h2>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">
          Pay a one-time onboarding fee. Get your first month free. No long-term contract.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="bg-white/10 backdrop-blur-sm p-8 flex flex-col">
          <span class="font-label text-secondary-fixed text-xs tracking-widest mb-2">Starter</span>
          <h3 class="text-2xl font-headline font-bold mb-1">Single Process Agent</h3>
          <p class="text-sm text-white/70 mb-6">One workflow. One Digital Employee.</p>
          <div class="mb-4">
            <span class="text-sm text-white/70 block">Onboarding Fee</span>
            <span class="text-4xl font-headline font-bold">JMD 49,000</span>
          </div>
          <div class="mb-6">
            <span class="text-sm text-white/70 block">Then per month</span>
            <span class="text-3xl font-headline font-bold">JMD 45,000</span>
          </div>
          <div class="bg-primary/30 px-4 py-3 text-center mb-6">
            <span class="font-label text-primary-fixed text-sm tracking-wider">First Month Free</span>
          </div>
          <ul class="space-y-3 mb-8 flex-grow text-sm">
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>1 workflow (invoicing, scheduling, etc.)</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Up to 500 transactions/month</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Email + WhatsApp channel</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Self-hosted on Jamaican infra</span></li>
          </ul>
          <a href="#cta" class="btn-primary bg-primary text-white justify-center text-center py-3">Book a Fit Call</a>
        </div>
        <div class="bg-primary p-8 flex flex-col scale-105 relative">
          <span class="absolute -top-3 right-8 bg-secondary text-on-secondary font-label text-xs tracking-widest px-3 py-1">Popular</span>
          <span class="font-label text-primary-fixed-dim text-xs tracking-widest mb-2">Growth</span>
          <h3 class="text-2xl font-headline font-bold mb-1">Multi-Process Agent</h3>
          <p class="text-sm text-white/70 mb-6">Three workflows. One Digital Employee.</p>
          <div class="mb-4"><span class="text-sm text-white/70 block">Onboarding Fee</span><span class="text-4xl font-headline font-bold">JMD 89,000</span></div>
          <div class="mb-6"><span class="text-sm text-white/70 block">Then per month</span><span class="text-3xl font-headline font-bold">JMD 85,000</span></div>
          <div class="bg-white/20 px-4 py-3 text-center mb-6"><span class="font-label text-white text-sm tracking-wider">First Month Free</span></div>
          <ul class="space-y-3 mb-8 flex-grow text-sm">
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Up to 3 workflows</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Up to 2,000 transactions/month</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Multi-channel (email, WhatsApp, SMS)</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Integration with existing tools</span></li>
          </ul>
          <a href="#cta" class="inline-block bg-secondary text-white text-center py-3 font-label uppercase tracking-widest text-sm">Book a Fit Call</a>
        </div>
        <div class="bg-white/10 backdrop-blur-sm p-8 flex flex-col">
          <span class="font-label text-secondary-fixed text-xs tracking-widest mb-2">Enterprise</span>
          <h3 class="text-2xl font-headline font-bold mb-1">Full Digital Employee</h3>
          <p class="text-sm text-white/70 mb-6">End-to-end role. Fully customized.</p>
          <div class="mb-4"><span class="text-sm text-white/70 block">Onboarding</span><span class="text-4xl font-headline font-bold">Custom</span></div>
          <div class="mb-6"><span class="text-sm text-white/70 block">Monthly</span><span class="text-3xl font-headline font-bold">Custom</span></div>
          <div class="bg-primary/30 px-4 py-3 text-center mb-6"><span class="font-label text-primary-fixed text-sm tracking-wider">First Month Free</span></div>
          <ul class="space-y-3 mb-8 flex-grow text-sm">
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Unlimited workflows</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>All channels + custom integrations</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Dedicated support + SLA</span></li>
            <li class="flex items-start gap-2"><svg class="h-4 w-4 text-secondary-fixed mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>On-premise available</span></li>
          </ul>
          <a href="#cta" class="inline-block text-center py-3 border border-white/30 text-white hover:bg-white hover:text-secondary font-label uppercase tracking-widest text-sm">Contact Us</a>
        </div>
      </div>
      <p class="text-center text-white/60 text-sm mt-10 max-w-2xl mx-auto">
        <strong class="text-white">Only 10 spaces available</strong> at launch pricing. 
        After that, standard onboarding fees apply. Self-hosted on Jamaican infrastructure.
      </p>
    </div>
  </section>

  <!-- Trust / Sovereignty -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center max-w-5xl mx-auto">
        <div>
          <span class="font-label text-primary tracking-widest text-sm">Data Sovereignty</span>
          <h2 class="text-3xl sm:text-4xl font-headline font-bold text-secondary mt-4 mb-6">
            Your Data Never Leaves Jamaica
          </h2>
          <p class="text-lg text-on-surface-variant mb-4">
            Every Digital Employee runs on Jamaican-hosted infrastructure. Unlike foreign SaaS platforms, 
            there are no hidden data exports, no training on your business data, no reliance on overseas servers.
          </p>
          <p class="text-lg text-on-surface-variant mb-6">
            Self-hosted or on-premise options available for regulated industries.
          </p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3"><svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span class="text-on-surface">Self-hosted on Jamaican infrastructure</span></li>
            <li class="flex items-center gap-3"><svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span class="text-on-surface">No training on your data</span></li>
            <li class="flex items-center gap-3"><svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span class="text-on-surface">No per-seat SaaS fees</span></li>
          </ul>
        </div>
        <div class="bg-surface-container p-12 text-center">
          <div class="text-7xl font-headline font-black text-primary/20 mb-4">JA</div>
          <p class="font-label text-primary text-sm tracking-widest">JAMAICAN HOSTED</p>
          <p class="text-on-surface-variant mt-4 text-sm">Built in Jamaica. For Jamaica.<br />Sovereign infra. Sovereign data.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-surface-container">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-headline font-bold text-secondary mb-4">Quick Answers</h2>
      </div>
      <div class="space-y-6">
        <div class="bg-surface p-6">
          <h3 class="font-headline font-bold text-secondary mb-2">How is this different from ChatGPT?</h3>
          <p class="text-on-surface-variant">ChatGPT answers questions. A Digital Employee does tasks — it sends invoices, books appointments, chases payments. It owns a process end-to-end.</p>
        </div>
        <div class="bg-surface p-6">
          <h3 class="font-headline font-bold text-secondary mb-2">How long does it take to set up?</h3>
          <p class="text-on-surface-variant">2 weeks from discovery to go-live for a Single Process Agent. Includes readiness assessment, workflow mapping, and training on your data.</p>
        </div>
        <div class="bg-surface p-6">
          <h3 class="font-headline font-bold text-secondary mb-2">Do I need technical staff to manage it?</h3>
          <p class="text-on-surface-variant">No. We manage the infrastructure. You interact through email, WhatsApp, or your existing tools — just like a human team member.</p>
        </div>
        <div class="bg-surface p-6">
          <h3 class="font-headline font-bold text-secondary mb-2">Can I compete with larger firms?</h3>
          <p class="text-on-surface-variant">Digital Employees are your force multiplier. Automate operations, cut manual work by 60-70%, and focus your team on growth — without increasing headcount. That's how Jamaican SMEs compete globally.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" class="py-20 lg:py-28 bg-primary text-white">
