---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout
  title="JTDA Tech Talk Tuesday — Digital Employees | Paradigm IT Services"
  description="Attending the JTDA Tech Talk on Digital Employees? Let's continue the conversation. Book a free Digital Employee Readiness Assessment."
>
  <Header logoVariant="mono-white" />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-secondary via-secondary to-primary/50 text-white py-28 lg:py-36 relative overflow-hidden">
    <div class="absolute -bottom-10 -right-20 text-[20rem] font-black text-white/5 font-headline pointer-events-none select-none" aria-hidden="true">
      Tech Talk
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-primary/30 text-primary-fixed px-4 py-2 font-label tracking-widest text-sm mb-6">
          JTDA Tech Talk Tuesday — June 30
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline font-black mb-6 ink-bleed">
          From Chatbots to Digital Employees.
        </h1>
        <p class="text-xl text-white/90 mb-8 max-w-3xl mx-auto">
          AI workers that handle invoicing, scheduling, procurement, and customer resolution —
          built for Jamaican SMEs. Self-hosted. Your data never leaves Jamaica.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#assessment" class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 bg-primary text-white hover:bg-primary/90 transition-colors">
            Free Readiness Assessment
          </a>
          <a href="https://www.linkedin.com/events/7473025093493743616" target="_blank" rel="noopener noreferrer" class="inline-block font-label uppercase tracking-widest text-sm font-bold px-8 py-4 border border-white/30 text-white hover:bg-white hover:text-secondary transition-all">
            View Event Details
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Context -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <span class="font-label text-primary tracking-widest text-sm">Attending the Event?</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mt-4 mb-6">
          Let's Continue the Conversation
        </h2>
        <p class="text-lg text-on-surface-variant mb-8">
          The JTDA Tech Talk Tuesday is exploring how Jamaican SMEs can move from simple chatbots
          to autonomous Digital Employees that own business processes end-to-end.
        </p>
        <p class="text-lg text-on-surface-variant mb-8">
          Paradigm IT Services builds exactly these. If you're attending the event and wondering
          <strong>"who actually builds this?"</strong> — we do. Self-hosted in Jamaica. 
          Built for SMEs. Starting at JMD 45,000/mo.
        </p>
        <div class="bg-surface-container p-8 border-l-4 border-primary">
          <p class="font-headline text-xl font-bold text-secondary mb-2">
            Launch Offer — 10 Spaces Only
          </p>
          <p class="text-on-surface-variant">
            Book a free Digital Employee Readiness Assessment before July 15 and get your first month free.
            No commitment required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Four Use Cases -->
  <section class="py-20 lg:py-28 bg-surface-container">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold text-secondary mb-6">
          What a Digital Employee Does
        </h2>
        <p class="text-lg text-on-surface-variant max-w-3xl mx-auto">
          The event covers these use cases. We build them.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-surface p-8 text-center">
          <div class="w-16 h-16 bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="font-headline font-bold text-secondary mb-2">Invoicing & Collections</h3>
          <p class="text-sm text-on-surface-variant">Chase payments, send reminders, reconcile accounts. End the manual chase.</p>
        </div>
        <div class="bg-surface p-8 text-center">
          <div class="w-16 h-16 bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          </div>
          <h3 class="font-headline font-bold text-secondary mb-2">Customer Resolution</h3>
          <p class="text-sm text-on-surface-variant">Handle inquiries, escalate smartly, learn from every interaction.</p>
        </div>
        <div class="bg-surface p-8 text-center">
          <div class="w-16 h-16 bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
          </div>
          <h3 class="font-headline font-bold text-secondary mb-2">Procurement</h3>
          <p class="text-sm text-on-surface-variant">Vendor selection, PO creation, delivery tracking — end to end.</p>
        </div>
        <div class="bg-surface p-8 text-center">
          <div class="w-16 h-16 bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="font-headline font-bold text-secondary mb-2">Scheduling</h3>
          <p class="text-sm text-on-surface-variant">Appointment booking, calendar management, reminders — no human needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA - Readiness Assessment -->
  <section id="assessment" class="py-20 lg:py-28 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-secondary/50 text-secondary-fixed px-4 py-2 font-label tracking-widest text-sm mb-6">
        Free + No Commitment
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline font-bold mb-6">
        Free Digital Employee Readiness Assessment
      </h2>
      <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
        1-hour discovery call. We'll identify your top 3 workflows ready for automation 
        and tell you exactly what it costs to build your first Digital Employee.
      </p>
      <div class="max-w-2xl mx-auto">
        <ContactForm title="Book Your Free Assessment" />
      </div>
      <p class="text-white/60 text-sm mt-6">
        Limited to the first 10 businesses at launch pricing. No commitment. 
        Your data stays in Jamaica.
      </p>
    </div>
  </section>
</BaseLayout>
